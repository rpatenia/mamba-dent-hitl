# Copy this file to .streamlit/secrets.toml (local dev) and/or paste its
# contents into the Streamlit Community Cloud app's Settings -> Secrets
# (hosted). Without this section present, the app automatically falls
# back to the local results/validation_results.csv — nothing else to
# configure for local-only use.
#
# Where to get the URL: Supabase project -> Project Settings -> Database
# -> Connection string -> "Session pooler" (recommended for a
# serverless/ephemeral host like Streamlit Community Cloud — it handles
# many short-lived connections better than the direct connection string).
# Fill in the password you set when creating the project.

[connections.validation_db]
url = "postgresql://postgres.xxxxxxxxxxxx:YOUR-PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Dataset source: presence of this section switches the app from reading
# local ToothFairy3\ files to streaming case files from a private
# Hugging Face Hub dataset repo instead — needed wherever the 28GB
# dataset isn't on local disk (any hosted deployment). Get a token at
# huggingface.co -> Settings -> Access Tokens (needs at least
# repo.content.read on the target repo; a write-scoped token also works
# but a read-only one is tighter for a deployed app).
[huggingface]
token = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
repo_id = "vvyern/toothfairy3-mamba-dent-hitl"
